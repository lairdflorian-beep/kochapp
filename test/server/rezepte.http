@host = http://localhost:3001

### Alle Rezepte abrufen – erwartet 200
GET {{host}}/rezepte

> {%
  client.test("Alle Rezepte werden geliefert", () =>
    client.assert(response.status === 200));
%}

### Unbekannte ID – erwartet 404
GET {{host}}/rezepte/99

> {%
  client.test("Unbekannte ID wird abgelehnt", () =>
    client.assert(response.status === 404));
%}

### Rezept anlegen – erwartet 201
POST {{host}}/rezepte
Content-Type: application/json

{
  "name": "Linsencurry",
  "autor": "Lena",
  "dauerMinuten": 35
}

> {%
  client.test("Rezept wurde angelegt", () =>
    client.assert(response.status === 201));
%}

### Ohne name – erwartet 400
POST {{host}}/rezepte
Content-Type: application/json

{
  "autor": "Lena",
  "dauerMinuten": 35
}

> {%
  client.test("Rezept ohne name wird abgelehnt", () =>
    client.assert(response.status === 400));
%}
