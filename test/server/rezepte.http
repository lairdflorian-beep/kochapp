@host = http://localhost:3001
@benutzer = max.mustermann
@passwort = test1234

### Alle Rezepte abrufen – erwartet 200
GET {{host}}/rezepte

### Ein Rezept abrufen – erwartet 200
GET {{host}}/rezepte/1

### Unbekannte ID – erwartet 404
GET {{host}}/rezepte/99

### Rezept anlegen mit Anmeldung – erwartet 201
POST {{host}}/rezepte
Authorization: Basic {{benutzer}} {{passwort}}
Content-Type: application/json

{
  "name": "Linsencurry",
  "autor": "Lena",
  "dauerMinuten": 35
}

### Ohne name – erwartet 400
POST {{host}}/rezepte
Authorization: Basic {{benutzer}} {{passwort}}
Content-Type: application/json

{
  "autor": "Lena",
  "dauerMinuten": 35
}

### Leerer autor – erwartet 400
POST {{host}}/rezepte
Authorization: Basic {{benutzer}} {{passwort}}
Content-Type: application/json

{
  "name": "Linsencurry",
  "autor": "   ",
  "dauerMinuten": 35
}

### Ungültige dauerMinuten – erwartet 400
POST {{host}}/rezepte
Authorization: Basic {{benutzer}} {{passwort}}
Content-Type: application/json

{
  "name": "Linsencurry",
  "autor": "Lena",
  "dauerMinuten": 0
}

### Ohne Body – erwartet 400
POST {{host}}/rezepte
Authorization: Basic {{benutzer}} {{passwort}}

### Anmelden mit richtigem Passwort – erwartet 200
POST {{host}}/login
Authorization: Basic {{benutzer}} {{passwort}}

### Anmelden mit falschem Passwort – erwartet 401
POST {{host}}/login
Authorization: Basic {{benutzer}} falsch

### Anmelden ohne Zugangsdaten – erwartet 401
POST {{host}}/login

### Rezept anlegen ohne Anmeldung – erwartet 401
POST {{host}}/rezepte
Content-Type: application/json

{
  "name": "Linsencurry",
  "autor": "Lena",
  "dauerMinuten": 35
}

### Rezept anlegen mit falschem Passwort – erwartet 401
POST {{host}}/rezepte
Authorization: Basic {{benutzer}} falsch
Content-Type: application/json

{
  "name": "Linsencurry",
  "autor": "Lena",
  "dauerMinuten": 35
}
